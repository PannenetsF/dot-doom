;;; startup-preheat-test.el --- First-input preheat tests -*- lexical-binding: t; -*-
;; emacs --batch -Q -l tests/startup-preheat-test.el -f ert-run-tests-batch-and-exit
(require 'ert)
(require 'cl-lib)
(defvar +preheat-first-input-done)
(defvar doom-first-input-hook)
(defvar startup-test-chinese-enabled t)
(defmacro modulep! (&rest _) 'startup-test-chinese-enabled)

(with-temp-buffer
  (insert-file-contents
   (expand-file-name "../config.el" (file-name-directory load-file-name)))
  (goto-char (point-min))
  (search-forward "(defun +preheat-lazy-packages-h ()")
  (beginning-of-line)
  (eval (read (current-buffer)) t))

(ert-deftest startup-preheat-runs-first-input-once ()
  (let ((+preheat-first-input-done nil)
        (doom-first-input-hook '(pending))
        events)
    (cl-letf (((symbol-function 'require)
               (lambda (feature &rest _) (push feature events)))
              ((symbol-function 'doom-run-hooks)
               (lambda (hook) (push hook events))))
      (+preheat-lazy-packages-h)
      (+preheat-lazy-packages-h)
      (should (equal (nreverse events) '(pyim doom-first-input-hook)))
      (should +preheat-first-input-done)
      (should-not doom-first-input-hook))))

(ert-deftest startup-preheat-does-not-load-disabled-input-module ()
  (let ((+preheat-first-input-done nil)
        (doom-first-input-hook nil)
        (startup-test-chinese-enabled nil))
    (cl-letf (((symbol-function 'require)
               (lambda (&rest _) (ert-fail "Unexpected speculative require")))
              ((symbol-function 'doom-run-hooks) #'ignore))
      (+preheat-lazy-packages-h)
      (should +preheat-first-input-done))))

(ert-deftest startup-preheat-preserves-hooks-on-error ()
  (let ((+preheat-first-input-done nil)
        (doom-first-input-hook '(pending))
        (startup-test-chinese-enabled nil))
    (cl-letf (((symbol-function 'doom-run-hooks)
               (lambda (&rest _) (error "Initialization failed"))))
      (should-error (+preheat-lazy-packages-h))
      (should-not +preheat-first-input-done)
      (should (equal doom-first-input-hook '(pending))))))
