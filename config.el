;; telega — Telegram client. Doom's doom+ module tree no longer ships an
;; `:app telega' module, so it is a plain package declared in
;; packages.el. Its C helper telega-server links -ltdjson; Homebrew
;; installs tdlib under /opt/homebrew (upstream's default /usr/local is
;; the Intel-era path).
(when (eq system-type 'darwin)
  (setq telega-server-libs-prefix "/opt/homebrew/opt/tdlib"))

(use-package! telega
  :defer t
  :init
  ;; Fresh clones and `doom upgrade' checkouts lack the telega-server
  ;; binary; upstream's `telega-server--ensure-build' would drop into a
  ;; y-or-n prompt on first launch, so build it noninteractively before
  ;; `telega' starts. Pin the build environment to Xcode CLT + Homebrew:
  ;; a nix-profile gmake/pkgconf leaks NIX_CFLAGS_COMPILE into the
  ;; compile and the link fails (same failure mode as the liberime
  ;; self-heal above).
  ;; Advice receives the prefix argument passed to `telega', so declare
  ;; the optional argument instead of letting the before-advice signal
  ;; `wrong-number-of-arguments' before telega itself runs.
  (defun +telega-ensure-server-h (&optional _arg)
    (let* ((exec-path (cons telega-directory exec-path))
           (server-bin (executable-find telega-server-command)))
      ;; Rebuild when the helper is missing OR cannot start (e.g. its
      ;; libtdjson dylib was replaced by a tdlib upgrade). Beware: on
      ;; signal death `call-process' returns a string ("Abort trap: 6")
      ;; rather than an integer exit status, so only exact 0 counts.
      (unless (or telega-use-docker
                  (eq 0 (and server-bin
                             (call-process server-bin nil nil nil "-h"))))
        (let ((process-environment
               (cons "PATH=/opt/homebrew/bin:/usr/bin:/bin"
                     (seq-remove
                      (lambda (s)
                        (and (stringp s)
                             (string-match-p
                              (rx string-start
                                  (or "NIX_CFLAGS_COMPILE" "NIX_LDFLAGS"
                                      "CPATH" "LIBRARY_PATH")
                                  "=")
                              s)))
                      process-environment))))
          (telega-server-build "")))))
  (advice-add 'telega :before #'+telega-ensure-server-h))

(map! :leader
      :desc "Telega" "o t" #'telega)

;; Exclude code/markup spans from prose spell-checking. Doom's spell module
;; already skips org PROPERTIES/LOGBOOK drawers and #+BEGIN_SRC/EXAMPLE
;; blocks globally, so these hooks add only the inline markup it doesn't
;; cover: org ~code~/=verbatim=, Markdown backticks/template vars, and
;; LaTeX spans in both. `require' first so the buffer-local copy starts
;; from ispell's defaults plus Doom's global entries, regardless of hook
;; order or whether flyspell is enabled in the buffer.
(defun +ispell-org-skip-regions-h ()
  "Exclude Org inline code/verbatim and LaTeX from spell checking."
  (require 'ispell)
  (make-local-variable 'ispell-skip-region-alist)
  (dolist (pair '(("~" "~") ("=" "=")
                  ("\\\\(" "\\\\)") ("\\[" "\\]")
                  ("^\\\\begin{[^}]+}" "^\\\\end{[^}]+}")))
    (add-to-list 'ispell-skip-region-alist pair)))

(defun +ispell-markdown-skip-regions-h ()
  "Exclude Markdown code and inline markup from spell checking."
  (require 'ispell)
  (make-local-variable 'ispell-skip-region-alist)
  (dolist (pair '(("`" "`")
                  ("^```" "^```")
                  ("{{" "}}")
                  ("\\\\(" "\\\\)") ("\\[" "\\]")
                  ("^\\\\begin{[^}]+}" "^\\\\end{[^}]+}")))
    (add-to-list 'ispell-skip-region-alist pair)))

(add-hook! 'org-mode-hook #'+ispell-org-skip-regions-h)
(add-hook! '(markdown-mode-hook markdown-ts-mode-hook)
           #'+ispell-markdown-skip-regions-h)
