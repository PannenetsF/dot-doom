    (unless (or (active-minibuffer-window)
                (and (not auto-revert-remote-files)
                     buffer-file-name
                     (file-remote-p buffer-file-name)))
      (let ((auto-revert-mode t))
        (auto-revert-handler))))

  (defun +auto-revert-window-buffer-h (window &rest _)
