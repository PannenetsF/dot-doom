  (let* ((banner '(
	           "████████ ██   ██ ██ ███    ██ ██   ██     ████████ ██     ██ ██  ██████ ███████ "
	           "   ██    ██   ██ ██ ████   ██ ██  ██         ██    ██     ██ ██ ██      ██      "
	           "   ██    ███████ ██ ██ ██  ██ █████          ██    ██  █  ██ ██ ██      █████   "
	           "   ██    ██   ██ ██ ██  ██ ██ ██  ██         ██    ██ ███ ██ ██ ██      ██      "
	           "   ██    ██   ██ ██ ██   ████ ██   ██        ██     ███ ███  ██  ██████ ███████ "
	           "                                                                                "
	           "                                                                                "
	           "      ██████  ██████  ██████  ███████      ██████  ███    ██  ██████ ███████    "
	           "     ██      ██    ██ ██   ██ ██          ██    ██ ████   ██ ██      ██         "
	           "     ██      ██    ██ ██   ██ █████       ██    ██ ██ ██  ██ ██      █████      "
	           "     ██      ██    ██ ██   ██ ██          ██    ██ ██  ██ ██ ██      ██         "
	           "      ██████  ██████  ██████  ███████      ██████  ██   ████  ██████ ███████    "))
         (longest-line (apply #'max (mapcar #'length banner))))
