;; Doom exposes five (optional) variables for controlling fonts in Doom:
;;
;; - `doom-font' -- the primary font to use
;; - `doom-variable-pitch-font' -- a non-monospace font (where applicable)
;; - `doom-big-font' -- used for `doom-big-font-mode'; use this for
;;   presentations or streaming.
;; - `doom-symbol-font' -- for symbols
;; - `doom-serif-font' -- for the `fixed-pitch-serif' face
;;
;; See 'C-h v doom-font' for documentation and more examples of what they
;; accept. For example:
;;

;; load doom env (generated by `doom env` in install-doom.sh); tolerate
;; a missing file so first launch before activation can't abort init
(doom-load-envvars-file (expand-file-name "doomenv" doom-user-dir) t)

;; Resolve notes directories early (before deferred org/org-roam load):
;; vulpea's file watcher otherwise sees the ~/org defaults and warns.
(setq org-directory "~/Documents/org/"
      org-roam-directory "~/Documents/org/roam/")
(make-directory org-directory t)

;; Keep in sync with kitty's font_family/font_size in
;; nix-hm: config/kitty/kitty.conf (Sarasa Term SC, 16.0). Sarasa pairs
;; Iosevka-Term-shaped Latin with Source Han Sans CJK on a strict
;; 500/1000 grid, so mixed CN/EN text is truly 2:1 aligned (Iosevka NF's
;; 600-wide Latin did not match LXGW Mono's 1000-wide CJK fallback).
(setq doom-font (font-spec :family "Sarasa Term SC" :size 16))
(setq use-default-font-for-symbols nil)

(defun private-cjk-font()
  ;; Sarasa Term SC covers CJK itself on the strict 500/1000 grid, so
  ;; list it first explicitly and append LXGW only for glyphs Sarasa
  ;; lacks.
  (dolist (charset '(kana han cjk-misc bopomofo))
    (set-fontset-font t charset (font-spec :family "Sarasa Term SC"))
    (set-fontset-font t charset (font-spec :family "LXGW WenKai Mono") nil t))
  ;; `symbol' charset (… U+2026, ™, μ, curly quotes, arrows, ⋯) has a
  ;; built-in fontset mapping that on macOS resolves to the PROPORTIONAL
  ;; "Apple Symbols" face and takes precedence over the default face —
  ;; Emacs counts those glyphs as one cell while the face paints 1.5-2
  ;; cells, so any which-key truncated entry pushes every later column
  ;; out of alignment. Pin the charset to the monospaced Sarasa first;
  ;; Apple Symbols stays appended only for the rare glyph Sarasa lacks
  ;; (harmless on Linux: the nonexistent family is simply skipped).
  (set-fontset-font t 'symbol (font-spec :family "Sarasa Term SC"))
  (set-fontset-font t 'symbol (font-spec :family "Apple Symbols") nil t))

(add-hook 'after-setting-font-hook #'private-cjk-font)

(after! doom-modeline
  (setq doom-modeline-bar-width 4
        doom-modeline-mu4e t
        doom-modeline-major-mode-icon t
        doom-modeline-major-mode-color-icon t
        doom-modeline-buffer-file-name-style 'truncate-upto-project))

;; If you or Emacs can't find your font, use 'M-x describe-font' to look them

;; up, `M-x eval-region' to execute elisp code, and 'M-x doom/reload-font' to
;; refresh your font settings. If Emacs still can't find your font, it likely
;; wasn't installed correctly. Font issues are rarely Doom issues!

;; There are two ways to load a theme. Both assume the theme is installed and
;; available. You can either set `doom-theme' or manually load a theme with the
;; `load-theme' function. This is the default:
(setq doom-theme 'doom-solarized-dark)

;; In a terminal frame (-nw) the palette belongs to the terminal, not to
;; Emacs — the same reason herdr pins `[theme] name = "terminal"`. Kitty
;; auto-switches its dark/light palette with macOS appearance (and the
;; kitty-theme picker can override it), so probe the terminal's *live*
;; background color and pick the matching ayu theme instead of forcing
;; the dark one. GUI frames keep `doom-ayu-dark' above.
(when (not (display-graphic-p))
  (defvar +terminal-dark-theme 'doom-solarized-dark)
  (defvar +terminal-light-theme 'doom-solarized-light)

  (defun +terminal--kitty-sockets ()
    "Reachable kitty control sockets, env hint first then /tmp newest.
Mirrors config/kitty/kitty-theme.sh: a herdr pane can outlive the kitty
it was launched from, so its KITTY_LISTEN_ON may be stale."
    (let* ((hint (when-let ((h (getenv "KITTY_LISTEN_ON")))
                   (string-remove-prefix "unix:" h)))
           (tmp-socks (sort (seq-filter #'file-exists-p
                                        (directory-files "/tmp" t
                                                         "^kitty-[0-9]+$"))
                            (lambda (a b)
                              (time-less-p (nth 5 (file-attributes b))
                                           (nth 5 (file-attributes a)))))))
      ;; Env hint first; remaining sockets newest-first (lexicographic
      ;; ordering is wrong for kitty-9 vs kitty-10).
      (delete-dups (if hint (cons hint tmp-socks) tmp-socks))))

  (defun +terminal--live-background ()
    "Return the terminal background as a 6-digit hex string, or nil."
    (or (when (executable-find "kitty")
          (cl-dolist (sock (+terminal--kitty-sockets))
            (with-temp-buffer
              (when (and (zerop (ignore-errors
                                  (call-process "kitty" nil t nil
                                                "@" "--to"
                                                (concat "unix:" sock)
                                                "get-colors")))
                         (progn (goto-char (point-min))
                                (re-search-forward
                                 "^background[[:space:]]+#\\([0-9a-fA-F]\\{6\\}\\)"
                                 nil t)))
                (cl-return (match-string 1))))))
        ;; COLORFGBG=<fg>;<bg-index> exported by some terminals.
        (let ((cfgbg (getenv "COLORFGBG")))
          (when (and cfgbg (string-match ";\\([0-9]+\\)\\s-*\\'" cfgbg))
            (if (< (string-to-number (match-string 1 cfgbg)) 8)
                "000000" "ffffff")))
        ;; Last resort: macOS system appearance (kitty auto mode follows it).
        (when (eq system-type 'darwin)
          (if (zerop (ignore-errors
                       (call-process "defaults" nil nil nil
                                     "read" "-g" "AppleInterfaceStyle")))
              "000000" "ffffff"))))

  (defun +terminal--luminance (hex)
    "Relative luminance (0..1) of a 6-digit srgb hex string."
    (let* ((chan (lambda (i)
                   (/ (string-to-number (substring hex i (+ i 2)) 16)
                      255.0)))
           (linear (lambda (c)
                     (if (<= c 0.03928) (/ c 12.92)
                       (expt (/ (+ c 0.055) 1.055) 2.4))))
           (r (funcall linear (funcall chan 0)))
           (g (funcall linear (funcall chan 2)))
           (b (funcall linear (funcall chan 4))))
      (+ (* 0.2126 r) (* 0.7152 g) (* 0.0722 b))))

  (defvar +terminal--theme-last-bg nil)
  (defvar +terminal--theme-last-check 0)
  (defun +terminal-sync-theme (&rest _)
    "Switch the active ayu theme to match the terminal background.
Re-checked at startup and whenever the tty frame regains focus (with
a 2s debounce), so a macOS dark/light flip lands on next focus. No-op
when detection fails or the palette has not changed."
    (interactive)
    (when (and (not (display-graphic-p))
               (> (float-time) (+ +terminal--theme-last-check 2.0))
               (let ((bg (+terminal--live-background)))
                 (and bg
                      (not (equal bg +terminal--theme-last-bg))
                      (setq +terminal--theme-last-bg bg)
                      (setq +terminal--theme-last-check (float-time))
                      bg)))
      (let* ((bg (or +terminal--theme-last-bg "000000"))
             (want (if (< (+terminal--luminance bg) 0.5)
                       +terminal-dark-theme
                     +terminal-light-theme)))
        (unless (eq want doom-theme)
          (setq doom-theme want)
          (mapc #'disable-theme custom-enabled-themes)
          (load-theme want t)
          (message "Terminal palette changed to #%s; using %s" bg want)))))

  ;; Pick the theme before Doom applies `doom-theme' at startup.
  (when-let ((bg (+terminal--live-background)))
    (setq +terminal--theme-last-bg bg)
    (setq doom-theme
          (if (< (+terminal--luminance bg) 0.5)
              +terminal-dark-theme
            +terminal-light-theme)))
  ;; Kitty reports tty focus events; reappearance flips happen while
  ;; Emacs is unfocused, so re-sync on the way back in.
  (add-hook 'after-init-hook
            (lambda () (add-hook 'focus-in-hook #'+terminal-sync-theme))))


;; This determines the style of line numbers in effect. If set to `nil', line
;; numbers are disabled. For relative line numbers, set this to `relative'.
(setq display-line-numbers-type 'relative)



;; Whenever you reconfigure a package, make sure to wrap your config in an
;; `after!' block, otherwise Doom's defaults may override your settings. E.g.
;;
;;   (after! PACKAGE
;;     (setq x y))
;;
;; The exceptions to this rule:
;;
;;   - Setting file/directory variables (like `org-directory')

;;   - Setting variables which explicitly tell you to set them before their
;;     package is loaded (see 'C-h v VARIABLE' to look up their documentation).
;;   - Setting doom variables (which start with 'doom-' or '+').
;;
;; Here are some additional functions/macros that will help you configure Doom.
;;
;; - `load!' for loading external *.el files relative to this one
;; - `use-package!' for configuring packages
;; - `after!' for running code after a package has loaded
;; - `add-load-path!' for adding directories to the `load-path', relative to
;;   this file. Emacs searches the `load-path' when you load packages with
;;   `require' or `use-package'.
;; - `map!' for binding new keys
;;
;; To get information about any of these functions/macros, move the cursor over
;; the highlighted symbol at press 'K' (non-evil users must press 'C-c c k').
;; This will open documentation for it, including demos of how they are used.
;; Alternatively, use `C-h o' to look up a symbol (functions, variables, faces,
;; etc).
;;
;; You can also try 'gd' (or 'C-c c d') to jump to their definition and see how
;; they are implemented.


;; Here we set up some additional configurations for Doom Emacs.
;; 1. the which-key delay is set to 0.1 seconds, which means that the key hints
(setq which-key-idle-delay 0.1)

;; Preheat lazy packages on first idle. Doom defers much of startup to the
;; first command/first feature use: pyim (the :input chinese module) loads
;; via `:after-call pre-command-hook', python's conda/pyvenv stack drags in
;; eshell/tramp with the first python buffer, treemacs (SPC e) and lsp-mode
;; each cost 0.7-1.1s on first use. Even with native-comp, those require
;; costs land on a keypress. Loading on the first idle second moves them off
;; the interaction; running one throwaway Evil motion also warms the lazy
;; machinery of the first command (evil-goggles/pulse, evil-easymotion,
;; orderless, company-capf, keymap normalization). vc-git/tramp-gvfs cover
;; treemacs' buffer-creation path so SPC e is warm end to end.
(defun +preheat-lazy-packages-h ()
  (ignore-errors
    (require 'evil)
    (when (modulep! :input chinese)
      (require 'pyim))
    (when (modulep! :lang python)
      (require 'conda)
      (require 'pyvenv))
    (when (modulep! :ui treemacs)
      (require 'treemacs)
      (require 'vc-git)
      (require 'tramp-gvfs))
    (when (modulep! :tools lsp)
      (require 'lsp-mode))
    (with-temp-buffer
      (evil-local-mode 1)
      (evil-normal-state 1)
      (evil-normalize-keymaps)
      (execute-kbd-macro "l"))))

(add-hook 'emacs-startup-hook
          (lambda ()
            (run-with-idle-timer 1 nil #'+preheat-lazy-packages-h)))

;; Push xref's marker stack before navigation commands that bypass xref
;; (`find-function', `consult-imenu', `consult-ripgrep', `citre-jump'), so
;; `M-,' (`xref-pop-marker-stack') can return from them. xref's own
;; find-definitions pushes automatically; these commands don't, so without
;; this advice the stack stays empty and `M-,' errors with "No previous
;; location". citre may be absent — advising an undefined function is
;; harmless and activates if citre is installed later.
(after! xref
  (setq xref-search-program 'ripgrep
        xref-history-storage 'xref-window-local-history))

(defadvice! +xref--push-marker-stack-a (&rest _)
  "Push xref's marker stack before navigation commands that bypass xref."
  :before '(find-function consult-imenu consult-ripgrep citre-jump)
  (xref-push-marker-stack (point-marker)))

;; Rime (liberime) data layout: shared data (default.yaml + luna-pinyin
;; schemas, deployed by rime/plum) lives in ~/Library/Rime; per-user state
;; (build caches, user dict) stays in Doom's cache dir.
(when (modulep! :input chinese +rime)
  (setq liberime-shared-data-dir "~/Library/Rime")
  ;; liberime ships a C module that straight does not compile (and on macOS its
  ;; Makefile falls through to gcc, which is broken under the nix profile).
  ;; Point liberime at the repo build product and build it on demand with
  ;; clang; this only runs when the module is missing (fresh checkout or after
  ;; a `doom upgrade` rebuild).
  (defun +liberime-ensure-module-h ()
    (let* ((repo (expand-file-name ".local/straight/repos/liberime/"
                                   doom-emacs-dir))
           (module (expand-file-name
                    (concat "src/liberime-core" module-file-suffix) repo)))
      (setq liberime-module-file module)
      (when (and (file-directory-p repo) (not (file-exists-p module)))
        (ignore-errors
          (with-temp-buffer
            (when (zerop (call-process "pkg-config" nil t nil "--cflags" "rime"))
              (let* ((pc-cflags (string-trim (buffer-string)))
                     (pc-libs (progn
                                (erase-buffer)
                                (and (zerop (call-process "pkg-config" nil t nil
                                                          "--libs" "rime"))
                                     (string-trim (buffer-string)))))
                     (args
                      `(,(format "CFLAGS=-fPIC -O2 -Wall -DHAVE_RIME_API %s -Iemacs-module/%d"
                                 pc-cflags emacs-major-version)
                        ,(format "LDFLAGS=-shared %s" (or pc-libs "-lrime"))
                        ,(format "EMACS_MAJOR_VERSION=%d" emacs-major-version)
                        ,@(when (eq system-type 'darwin) '("CC=clang")))))
                (let ((default-directory repo)
                      (process-environment
                       (if (eq system-type 'darwin)
                           (seq-remove
                            (lambda (s)
                              (and (stringp s)
                                   (string-match-p
                                    (rx string-start
                                        (or "NIX_CFLAGS_COMPILE"
                                            "NIX_LDFLAGS" "CPATH"
                                            "LIBRARY_PATH")
                                        "=")
                                    s)))
                            process-environment)
                         process-environment)))
                  (apply #'call-process "make" nil nil nil "clean" args)
                  (apply #'call-process "make" nil nil nil args)))))))))
  (advice-add 'liberime-load :before #'+liberime-ensure-module-h)

  ;; liberime 0.0.11 runs `liberime-search' on an EPHEMERAL session (older
  ;; releases composed on the shared default session). pyim 5.3.6's
  ;; `pyim-liberime--get-code' -- called by `pyim-process-select-word', i.e.
  ;; every space/digit candidate commit -- still expects the follow-up
  ;; `liberime-get-preedit' (which reads the default session) to see what was
  ;; just searched, so it hands nil to `split-string' and every commit dies
  ;; with (wrong-type-argument stringp nil). Redo the lookup inside one
  ;; explicit temporary session, passed via the new SESSION argument.
  (after! pyim-liberime
    (defun +pyim-rime-get-code-a (orig word input &rest _)
      (if (and (fboundp 'liberime-session-create)
               (fboundp 'liberime-session-destroy)
               (stringp word) (stringp input)
               (string-match-p
                (string-join
                 '("pinyin" "luna" "terra" "bopomofo" "stenotype"
                   "jyut6ping3" "wugniu" "soutzoe" "zyenpheng"
                   "sampheng" "clover")
                 "\\|")
                (or (alist-get 'schema_id (liberime-get-status)) "")))
          (condition-case _
              (let* ((sid (liberime-session-create))
                     (preedit-for
                      (lambda (s)
                        (liberime-search s 1 nil nil nil sid)
                        (or (alist-get
                             'preedit
                             (alist-get 'composition
                                        (liberime-get-context sid)))
                            "")))
                     (n (length word))
                     (syllables (split-string (funcall preedit-for input)
                                              "[ ']+"))
                     (target (cl-subseq syllables 0
                                        (min n (length syllables))))
                     (i (min (length input) (* n 5)))
                     str)
                (unwind-protect
                    (while (> i 0)
                      (setq str (substring input 0 i))
                      (if (equal target
                                 (split-string (funcall preedit-for str)
                                               "[ ']+"))
                          (setq i 0)
                        (setq i (1- i))))
                  (liberime-session-destroy sid))
                (or str input))
            (error input))
        (funcall orig word input)))
    (advice-add 'pyim-liberime--get-code :around
                #'+pyim-rime-get-code-a)))

